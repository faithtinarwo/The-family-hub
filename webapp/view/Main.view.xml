<mvc:View
    controllerName="family.dash.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:layout="sap.ui.layout"
    displayBlock="true">
    
    <f:DynamicPage id="mainPage">
        <f:title>
            <f:DynamicPageTitle id="mainPageTitle">
                <f:heading>
                    <Title id="headerTitle" text="Family Dashboard" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox id="mainVBox" class="sapUiSmallMargin">
                
                <Title id="t1" text="Household" class="sapUiSmallMarginBottom" />
                <layout:Grid id="g1" defaultSpan="XL3 L3 M6 S12">
                    <GenericTile id="shoppingTile" header="Shopping List" press=".onOpenChores">
                        <TileContent id="tc1">
                            <NumericContent id="nc1" value="5" icon="sap-icon://cart" />
                        </TileContent>
                    </GenericTile>

                    <GenericTile id="choresTile" header="Chores" press=".onOpenChores">
                        <TileContent id="tc2">
                            <NumericContent id="nc2" value="3" icon="sap-icon://checklist" valueColor="Good" />
                        </TileContent>
                    </GenericTile>
                </layout:Grid>

                <Title id="t2" text="Management (Locked)" class="sapUiMediumMarginTop sapUiSmallMarginBottom" />
                <layout:Grid id="g2" defaultSpan="XL3 L3 M6 S12">
                    <GenericTile id="adminTile" header="Parental Controls" frameType="OneByOne" press=".onOpenAdmin">
                        <TileContent id="tc3" footer="Restricted">
                            <ImageContent id="ic1" src="sap-icon://settings" />
                        </TileContent>
                    </GenericTile>

                    <GenericTile id="budgetTile" header="Budget Tracker" frameType="OneByOne" press=".onOpenAdmin">
                        <TileContent id="tc4" footer="Restricted">
                            <ImageContent id="ic2" src="sap-icon://money-bills" />
                        </TileContent>
                    </GenericTile>
                </layout:Grid>

                <ProgressIndicator id="familyProgress" class="sapUiMediumMarginTop" percentValue="0" displayValue="Loading..." state="Information" />
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>