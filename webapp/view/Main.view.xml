<mvc:View
    controllerName="family.dash.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:layout="sap.ui.layout"
    displayBlock="true">
    
    <f:DynamicPage id="dynamicPageId" headerExpanded="true" toggleHeaderOnTitleClick="true">
        <f:title>
            <f:DynamicPageTitle id="pageTitle">
                <f:heading>
                    <Title id="mainTitle" text="{i18n>mainPageTitle}" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox id="mainContainer" class="sapUiSmallMargin">
                
                <Title id="householdTitle" text="{i18n>householdTitle}" titleStyle="H4" class="sapUiSmallMarginBottom" />
                <layout:Grid id="householdGrid" defaultSpan="XL3 L3 M6 S12" class="sapUiSmallMarginBottom">
                    <GenericTile id="shoppingTile" header="{i18n>shoppingTileTitle}" subheader="{i18n>shoppingTileSub}" press=".onOpenShopping">
                        <TileContent id="shoppingContent">
                            <NumericContent id="shoppingNum" value="5" indicator="Up" valueColor="Critical" icon="sap-icon://cart" />
                        </TileContent>
                    </GenericTile>

                    <GenericTile id="choresTile" header="{i18n>choresTileTitle}" subheader="{i18n>choresTileSub}" press=".onOpenChores">
                        <TileContent id="choresContent">
                            <NumericContent id="choresNum" value="3" valueColor="Good" icon="sap-icon://checklist" />
                        </TileContent>
                    </GenericTile>
                </layout:Grid>

                <Toolbar id="spacer" height="2rem" style="Clear" />

                <Title id="mgmtTitle" text="{i18n>mgmtTitle}" titleStyle="H4" class="sapUiSmallMarginBottom" />
                <layout:Grid id="mgmtGrid" defaultSpan="XL3 L3 M6 S12">
                    <GenericTile id="leaveTile" header="{i18n>leaveTileTitle}" subheader="{i18n>leaveTileSub}" press=".onOpenLeave">
                        <TileContent id="leaveContent">
                            <FeedContent id="leaveFeed" subheader="2 New Requests" />
                        </TileContent>
                    </GenericTile>

                    <GenericTile id="mealTile" header="{i18n>mealTileTitle}" subheader="{i18n>mealTileSub}" press=".onOpenMeals">
                        <TileContent id="mealContent">
                            <ImageContent id="mealImage" src="sap-icon://meal" />
                        </TileContent>
                    </GenericTile>
                </layout:Grid>

            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>