<mvc:View
    controllerName="family.dash.controller.Chores"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core">
    <f:DynamicPage id="choresPage">
        <f:title>
            <f:DynamicPageTitle id="choresPageTitle">
                <f:heading>
                    <Title id="choresHeadingText" text="My Tasks &amp; Chores" />
                </f:heading>
                <f:navigationActions>
                    <Button id="btnNavBackFromChores" icon="sap-icon://home" press=".onNavBack" />
                </f:navigationActions>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox id="choresContent" class="sapUiSmallMargin">
                <SearchField id="searchChores" liveChange=".onSearch" placeholder="Search tasks..." class="sapUiSmallMarginBottom" />
                
                <List id="kidsChoreList" 
                      items="{chores>/items}" 
                      noDataText="No chores assigned yet. Relax!">
                    <items>
                        <ObjectListItem id="choreItem"
                            title="{chores>taskName}"
                            number="{chores>points}"
                            numberUnit="pts"
                            type="Inactive">
                            <attributes>
                                <ObjectAttribute id="attrAssignee" text="Assigned to: {chores>assignedTo}" />
                                <ObjectAttribute id="attrDue" text="Due: {chores>dueDate}" visible="{= !!${chores>dueDate} }" />
                            </attributes>
                            <firstStatus>
                                <ObjectStatus id="statusIndicator"
                                    text="{chores>status}"
                                    state="{= ${chores>status} === 'New' ? 'Information' : 'Warning'}" />
                            </firstStatus>
                        </ObjectListItem>
                    </items>
                </List>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
