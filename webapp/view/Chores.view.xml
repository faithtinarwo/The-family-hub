<mvc:View
    controllerName="family.dash.controller.Chores"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout">
    <Page id="choresPage" title="My Chores" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <List id="choresList" 
                  items="{chores>/items}" 
                  headerText="Tasks for Today"
                  noDataText="All caught up! Time to relax.">
                <CustomListItem id="choreListItem">
                    <HBox id="choreItemBox" alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMargin">
                        <VBox id="choreTextContainer">
                            <Text id="choreNameText" text="{chores>taskName}" renderWhitespace="true" class="sapUiSmallMarginBottom" />
                            <Label id="choreRewardLabel" text="Reward: {chores>points} points" design="Bold" />
                        </VBox>
                        <CheckBox id="choreStatusCheckBox" selected="{chores>completed}" select=".onTaskStatusChange" />
                    </HBox>
                </CustomListItem>
            </List>
        </content>
        <footer>
            <OverflowToolbar id="choresFooterToolbar">
                <ToolbarSpacer id="footerSpacer" />
                <Button id="claimRewardsButton" text="Claim Rewards" type="Emphasized" press=".onClaimRewards" />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
